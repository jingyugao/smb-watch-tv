<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tvwatch_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tvwatch_card"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="tvwatch"
                android:textColor="#FFFFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="SMB 电视剧播放器"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tvwatch_card"
            android:padding="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tab_recent"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:text="@string/tab_recent"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btn_tab_playlist"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:text="@string/tab_playlist"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btn_tab_smb"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:text="@string/tab_smb"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tvwatch_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_recent_title"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/section_recent_hint"
                android:textColor="#B9FFFFFF"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/lv_recent_playlists"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tvwatch_inner_card"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:divider="#00000000"
                android:dividerHeight="8dp"
                android:padding="6dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_playlists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tvwatch_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_playlists_title"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/section_playlists_hint"
                android:textColor="#B9FFFFFF"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/lv_playlists"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tvwatch_inner_card"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:divider="#00000000"
                android:dividerHeight="8dp"
                android:padding="6dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_smb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tvwatch_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMB 管理"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="先保存连接，再进入目录把电视剧目录加入播放列表。"
                android:textColor="#B9FFFFFF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_smb_host"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:hint="@string/label_smb_host"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textSize="18sp"
                android:padding="14dp"
                android:focusable="true" />

            <EditText
                android:id="@+id/et_smb_username"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:hint="@string/label_username"
                android:inputType="textEmailAddress"
                android:selectAllOnFocus="true"
                android:textSize="18sp"
                android:padding="14dp"
                android:focusable="true" />

            <EditText
                android:id="@+id/et_smb_password"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:hint="@string/label_password"
                android:inputType="textPassword"
                android:selectAllOnFocus="true"
                android:textSize="18sp"
                android:padding="14dp"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_add_connection"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_button_selector"
                    android:text="@string/btn_add_connection"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_test_connection"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_button_selector"
                    android:text="@string/btn_test_connection"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hint_status"
                android:textColor="#BBFFFFFF"
                android:textSize="14sp"
                android:minHeight="36dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tvwatch_inner_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_saved_connections"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/lv_connections"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tvwatch_inner_card"
                android:choiceMode="singleChoice"
                android:listSelector="@android:color/transparent"
                android:divider="#00000000"
                android:dividerHeight="8dp"
                android:padding="6dp"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
