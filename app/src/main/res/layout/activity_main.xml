<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tvwatch_bg"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tvwatch_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMB追剧"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="你的局域网影院"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btn_tab_recent"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_tvwatch_button_selector"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:nextFocusRight="@id/lv_recent_playlists"
            android:paddingStart="22dp"
            android:text="@string/tab_recent"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp" />

        <Button
            android:id="@+id/btn_tab_playlist"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tvwatch_button_selector"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:nextFocusRight="@id/lv_playlists"
            android:paddingStart="22dp"
            android:text="@string/tab_playlist"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp" />

        <Button
            android:id="@+id/btn_tab_smb"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tvwatch_button_selector"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:nextFocusRight="@id/btn_discover_smb"
            android:paddingStart="22dp"
            android:text="@string/tab_smb"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="方向键移动  ·  确认打开  ·  返回上级"
            android:textColor="#77FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/section_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_recent_title"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/section_recent_hint"
                android:textColor="#AAFFFFFF"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/lv_recent_playlists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tvwatch_card"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:nextFocusLeft="@id/btn_tab_recent"
                android:padding="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_playlists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_playlists_title"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="选择电视剧查看选集，播放按钮继续上次进度。"
                android:textColor="#AAFFFFFF"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/lv_playlists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tvwatch_card"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:nextFocusLeft="@id/btn_tab_playlist"
                android:padding="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_smb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMB 管理"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_discover_smb"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_tab_smb"
                android:text="@string/btn_discover_smb"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_smb_host"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_tvwatch_inner_card"
                    android:hint="@string/label_smb_host"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/et_smb_username"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_inner_card"
                    android:hint="@string/label_username"
                    android:inputType="text"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/et_smb_password"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_inner_card"
                    android:hint="@string/label_password"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_test_connection"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_button_selector"
                    android:text="@string/btn_test_connection"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_add_connection"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tvwatch_button_selector"
                    android:text="@string/btn_add_connection"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tvwatch_inner_card"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/hint_status"
                android:textColor="#BBFFFFFF"
                android:textSize="14sp" />

            <ListView
                android:id="@+id/lv_connections"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tvwatch_card"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:nextFocusLeft="@id/btn_tab_smb"
                android:padding="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
