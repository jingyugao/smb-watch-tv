<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_tvwatch_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tvwatch_card"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMB 目录浏览"
            android:textColor="#E6FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_browser_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="#B1E5FF"
            android:textSize="14sp"
            android:minHeight="40dp"
            android:background="@drawable/bg_tvwatch_inner_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="添加当前目录后，会扫描它和所有子目录；每个直接包含视频的文件夹生成一个独立播放列表。"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_browser_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tvwatch_card"
        android:choiceMode="singleChoice"
        android:listSelector="@android:color/transparent"
        android:divider="#00000000"
        android:dividerHeight="8dp"
        android:padding="6dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btn_add_current_directory"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tvwatch_button_selector"
        android:text="扫描当前目录并生成播放列表"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="20sp"
        android:focusable="true" />
</LinearLayout>
