<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF02070D">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusDown="@id/btn_play_toggle" />

    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6121B25"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_player_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="准备中..."
            android:textColor="#BBFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_player_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="缓冲检测中"
            android:textColor="#8FE7C8"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sb_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:focusable="true"
            android:nextFocusUp="@id/player_view" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_progress_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_progress_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_prev_episode"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/player_view"
                android:text="上一集"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_play_toggle"
                android:layout_width="170dp"
                android:layout_height="62dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/player_view"
                android:text="播放/暂停"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_next_episode"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/player_view"
                android:text="下一集"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_episode_list"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/player_view"
                android:text="选集"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_replay"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/player_view"
                android:text="重播"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_play_toggle"
                android:text="倍速 1.0x"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_audio_track"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_episode_list"
                android:text="音轨"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_subtitle_track"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_episode_list"
                android:text="字幕"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_seek_step"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_replay"
                android:text="跳转 10秒"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_resize_mode"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_replay"
                android:text="画面 适配"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_playback_info"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tvwatch_button_selector"
                android:nextFocusUp="@id/btn_replay"
                android:text="播放信息"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
